# Optimized Streamlit Service
# Inherits from base image to eliminate duplication
FROM Dockerfile.base AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Runtime Stage
FROM Dockerfile.base

ENV STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_LOGGER_LEVEL=info \
    PORT=8501

COPY --from=builder /root/.local /home/appuser/.local
COPY --chown=appuser:appuser streamlit_app.py .

ENV PATH=/home/appuser/.local/bin:$PATH

EXPOSE 8501
CMD ["streamlit", "run", "streamlit_app.py", "--logger.level=info"]
