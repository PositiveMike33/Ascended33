# Multi-stage Dockerfile for Report Generator Service
# Generates audit reports in multiple formats with legal compliance
# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VAULT_PATH=/vault \
    REPORT_OUTPUT_PATH=/app/reports \
    LEGAL_FRAMEWORK=THIRTY3

# Install runtime dependencies including PDF generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    wkhtmltopdf \
    xvfb \
    fontconfig \
    fonts-liberation \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 reportgen

WORKDIR /app

# Copy Python dependencies from builder
COPY --from=builder /root/.local /home/reportgen/.local

# Create data directories
RUN mkdir -p /app/reports /app/templates /app/data /vault && \
    chown -R reportgen:reportgen /app /vault

# Copy application files
COPY --chown=reportgen:reportgen report_generator.py .
COPY --chown=reportgen:reportgen report_api.py .
COPY --chown=reportgen:reportgen templates/ /app/templates/
COPY --chown=reportgen:reportgen models/ /app/models/
COPY --chown=reportgen:reportgen formatters/ /app/formatters/
COPY --chown=reportgen:reportgen legal_validators/ /app/legal_validators/

# Switch to non-root user
USER reportgen

# Update PATH
ENV PATH=/home/reportgen/.local/bin:$PATH

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8005/health || exit 1

# Expose port for API
EXPOSE 8005

# Run Report Generator API
CMD ["python", "-m", "uvicorn", "report_api:app", "--host", "0.0.0.0", "--port", "8005"]
