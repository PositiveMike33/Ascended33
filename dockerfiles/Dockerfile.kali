FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    openssh-server \
    nmap \
    hashcat \
    dnsutils \
    whois \
    traceroute \
    netcat-openbsd \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace /vault /root/.ssh
WORKDIR /workspace

EXPOSE 22

HEALTHCHECK --interval=15s --timeout=10s --retries=3 \
    CMD test -d /workspace || exit 1

CMD ["sleep", "infinity"]
